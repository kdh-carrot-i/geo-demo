# Copy to .env (never commit .env). Keys are only read by the server proxy — never prefix with VITE_.

# 공공데이터포털 https://www.data.go.kr → 마이페이지 → 일반 인증키(Decoding)
DATA_GO_KR_SERVICE_KEY=

# 브이월드 https://www.vworld.kr → 오픈API 인증키 (WMTS + 데이터 API)
VWORLD_KEY=
# domain registered with the VWorld key
VWORLD_DOMAIN=localhost

# 한국부동산원 R-ONE https://www.reb.or.kr/r-one → OpenAPI 인증키
R_ONE_KEY=

# 통계청 SGIS https://sgis.mods.go.kr/developer → 서비스 ID / 보안 Key
SGIS_SERVICE_ID=
SGIS_SECRET_KEY=

# 서울 열린데이터광장 https://data.seoul.go.kr → 일반 인증키
SEOUL_OPEN_API_KEY=

# 카카오 https://developers.kakao.com → REST API 키 (카카오맵 기능 활성화 필요)
KAKAO_REST_KEY=
# 카카오 JavaScript 키 (같은 앱의 'JavaScript 키'). 심사 화면의 지도·로드뷰 표시용 — 브라우저에 공개되는 키이며 등록 도메인에서만 동작
KAKAO_JS_KEY=
# origin sent in the KA header; must be one of the key's registered platform domains
KAKAO_ORIGIN=http://localhost:8000

API_PORT=8787

# Claude API https://console.anthropic.com (로드뷰 판독·요약·대화). 비어 있으면 해당 기능을 건너뛴다
ANTHROPIC_API_KEY=
# 모델·추론 강도 (선택)
# AGENT_MODEL=claude-opus-5-5
# AGENT_EFFORT=medium
# Agent API 호출 키 (쉼표로 여러 개). 비어 있으면 인증 없이 열림 — 로컬 개발 전용
AGENT_API_KEYS=

# 경기데이터드림 (data.gg.go.kr) Open API 인증키 — 경기도 유동인구 등
GG_OPEN_API_KEY=
