{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green npm:dev:api npm:dev:web",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json",
    "check:keys": "tsx scripts/check-keys.ts",
    "smoke:api": "tsx scripts/smoke-api.ts",
    "aws:start": "powershell -NoProfile -ExecutionPolicy Bypass -File ../deploy/ec2.ps1 start",
    "aws:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File ../deploy/ec2.ps1 stop",
    "aws:status": "powershell -NoProfile -ExecutionPolicy Bypass -File ../deploy/ec2.ps1 status",
    "aws:push": "powershell -NoProfile -ExecutionPolicy Bypass -File ../deploy/push.ps1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "express": "^5.1.0",
    "hyparquet": "1.31.4",
    "multer": "^2.5.0",
    "ol": "^10.6.1",
    "proj4": "^2.19.10",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/express": "^5.0.3",
    "@types/geojson": "^7946.0.16",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.3.0",
    "@types/proj4": "^2.5.6",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "tsx": "^4.20.6",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5"
  }
}
